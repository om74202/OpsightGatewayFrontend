# Create this file outside the repo at /etc/gateway/gateway_frontend.env
# Override the default path only if needed with:
# GATEWAY_FRONTEND_ENV_FILE=/custom/path/gateway_frontend.env

REACT_APP_API_URL=http://localhost:3001/api/v1
REACT_APP_API_WEBSOCKET_URL=ws://localhost:3001
REACT_APP_ENABLE_EDGE_OPCUA=true
REACT_APP_ENABLE_EDGE_MODBUS_RTU=true
REACT_APP_ENABLE_EDGE_MODBUS_TCP=true
REACT_APP_ENABLE_EDGE_ETHERNET_IP=false
REACT_APP_ENABLE_EDGE_S7=true
REACT_APP_ENABLE_EDGE_SLMP=true
